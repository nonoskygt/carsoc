<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Modelo viejo: permisos normales, concedidos al instalar. -->
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!-- Android 12+: permisos en tiempo de ejecucion. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />

    <!--
      Hasta API 30 Android exige ubicacion fina para barrer por Bluetooth:
      sin ella startDiscovery no devuelve nada y parece que no hay adaptador.
      De API 31 en adelante basta BLUETOOTH_SCAN con neverForLocation.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />

    <!-- Descargar el APK nuevo del servidor del taller. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Sin esto, Wi-Fi en ahorro de energia descarta las difusiones UDP. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!--
      Instalar actualizaciones desde la propia app. Android sigue pidiendo
      una confirmacion en pantalla; la contesta InstallAutoClickService.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Abrir el tablero al encender el carro; si no, tras cada reinicio
         nadie revisa si hay actualizacion hasta que alguien toque el icono. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <!-- Para armar el APK confirmador. Nivel "signature": solo funciona
         porque ambos APK llevan el mismo certificado. -->
    <uses-permission android:name="com.nonosky.s2000dash.permission.ARMAR" />

    <queries>
        <package android:name="com.nonosky.s2000dash.confirmador" />
    </queries>

    <uses-feature android:name="android.hardware.bluetooth" android:required="true" />
    <!-- La bateria de litio habla Bluetooth LE, que es otra radio que la
         clasica del adaptador OBD. Sin required: si un head unit no la trae,
         el resto del tablero sigue sirviendo. -->
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <!-- El receptor TPMS cuelga del USB. Enumerar no pide permiso; solo
         abrir el aparato lo pide. -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.S2000Dash">

        <activity
            android:name=".DashActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:theme="@style/Theme.S2000Dash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Sostiene el puente de diagnostico y la revision de
             actualizaciones aunque el tablero no este en pantalla. -->
        <service
            android:name=".DashService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter android:priority="900">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
            <intent-filter>
                <!-- Tras actualizarse a si misma, el sistema mata el proceso
                     y hay que volver a levantar el tablero. -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
            <intent-filter>
                <!-- La alarma de resurreccion. El dueño tenia que abrir la app
                     a mano tras cada reinicio: estas ROMs matan servicios y no
                     siempre respetan BOOT_COMPLETED ni START_STICKY. -->
                <action android:name="com.nonosky.s2000dash.RESUCITAR" />
            </intent-filter>
        </receiver>

        <!-- Lo que el confirmador ve en pantalla; sin esto no hay forma de
             depurarlo, porque no tiene pantalla ni logs accesibles. -->
        <receiver
            android:name=".ConfirmadorReceiver"
            android:exported="true"
            android:permission="com.nonosky.s2000dash.permission.ARMAR">
            <intent-filter>
                <action android:name="com.nonosky.s2000dash.CONFIRMADOR_DICE" />
            </intent-filter>
        </receiver>

        <!-- Desenlace de cada sesion de instalacion. -->
        <receiver
            android:name=".selfupdate.InstallStatusReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.nonosky.s2000dash.INSTALL_STATUS" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
